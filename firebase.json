{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "*.local"]
    }
  ],
  "emulators": {
    "firestore": { "port": 8099 },
    "auth": { "port": 9098 },
    "ui": { "enabled": true }
  }
}
