rules_version = '2';

// Ceti B2B2C — multi-tenant rules. Authorization is driven ENTIRELY by CUSTOM
// CLAIMS (role, colegioId, cursoId) set by a Cloud Function; never by
// client-writable fields (R2). Students are identified by their Auth `uid` (R1):
// there is no pseudonym key and no active sede claim. Tenant isolation: a request
// can only ever touch its own colegioId. Uses least-privilege rules. Default deny.
//
// D-PIVOT/D-ADMIN: `admin`, `profesor` and `estudiante` are the only roles.
// Admin provisioning is requested from its in-app panel but executed by Cloud
// Functions, so these rules intentionally grant no direct structure writes.
// `rector` and `coordinador` are removed entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers (claims only — R2) ----
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return signedIn() ? request.auth.token.role : '';
    }
    function isRole(r) {
      return role() == r;
    }
    function sameColegio(cid) {
      return signedIn() && request.auth.token.colegioId == cid;
    }
    // The only staff role left in-app is profesor (D-PIVOT).
    function isStaff() {
      return isRole('profesor');
    }
    // uid is listed as a teacher of this course (one get()).
    function isProfesorDe(cid, cursoId) {
      return isRole('profesor')
        && sameColegio(cid)
        && request.auth.uid in
          get(/databases/$(database)/documents/colegios/$(cid)/cursos/$(cursoId)).data.profesorUids;
    }
    // Who may OPERATE a course (assignments, codes, attestation, toggles): the
    // course's teacher. Structural provisioning is Admin SDK only (backend).
    function canOperarCurso(cid, cursoId) {
      return isProfesorDe(cid, cursoId);
    }
    // Ley 1581 gate: a student only generates data once a staffer attested the
    // acudiente authorization and estado flipped to 'activo'. get() on a missing
    // doc errors → denied, so this also implies existence.
    function estudianteActivo(cid, cursoId, uid) {
      return get(
        /databases/$(database)/documents/colegios/$(cid)/cursos/$(cursoId)/estudiantes/$(uid)
      ).data.estado == 'activo';
    }
    // A student can be in up to 5 classes: the token carries `clases`, a map
    // {cursoId: colegioId}. Tokens minted before that carry a single
    // colegioId/cursoId pair, still honored until they refresh.
    function clasesDelToken() {
      return request.auth.token.get('clases', {});
    }
    function enClaseSegunToken(cid, cursoId) {
      return clasesDelToken().get(cursoId, '') == cid
        || (request.auth.token.get('colegioId', '') == cid
          && request.auth.token.get('cursoId', '') == cursoId);
    }
    // The student's claims point to this course, whatever their estado. Lets a
    // student who still waits for the attestation see their class name and
    // their own roster status (never progress or classmates).
    function isMiembroDeCurso(cid, cursoId) {
      return isRole('estudiante') && enClaseSegunToken(cid, cursoId);
    }
    // Member of some class of this colegio (to read its name/logo).
    function isEstudianteDeColegio(cid) {
      return isRole('estudiante') && cid in clasesDelToken().values();
    }
    function isEstudianteActivoEnCurso(cid, cursoId, uid) {
      return isRole('estudiante')
        && request.auth.uid == uid
        && enClaseSegunToken(cid, cursoId)
        && estudianteActivo(cid, cursoId, uid);
    }
    // Fase 1 — un intento de lección o de jefe con sus respuestas (≤ 40).
    function pruebaAbierta(cid, cursoId, fase) {
      let cfg = get(/databases/$(database)/documents/colegios/$(cid)/cursos/$(cursoId)/config/prueba).data;
      return cfg.get(fase, null) != null
        && cfg.get(fase, {}).get('abiertaAt', null) is number
        && cfg.get(fase, {}).get('cerradaAt', null) == null;
    }
    function intentoValido(d, uid) {
      return d.keys().hasOnly(['worldId', 'tipo', 'nivel', 'resultado', 'inicioAt', 'finAt',
          'duracionMs', 'total', 'aciertos', 'respuestas', 'uid', 'creadoAt'])
        && d.uid == uid
        && d.worldId is string && d.worldId.size() > 0 && d.worldId.size() <= 60
        && d.tipo in ['leccion', 'jefe']
        && (d.nivel == null || (d.nivel is int && d.nivel >= 0 && d.nivel < 50))
        && d.resultado in ['completado', 'perdido']
        && d.inicioAt is number && d.finAt is number && d.finAt >= d.inicioAt
        && d.duracionMs is number && d.duracionMs >= 0 && d.duracionMs <= 7200000
        && d.total is int && d.total >= 0 && d.total <= 40
        && d.aciertos is int && d.aciertos >= 0 && d.aciertos <= d.total
        && d.respuestas is list && d.respuestas.size() == d.total
        && d.creadoAt == request.time;
    }
    // Fase 8a — una respuesta de la clase en vivo: la pregunta `n` está abierta
    // en ESTA sesión, una opción que existe y el id `{n}_{uid}`.
    function respuestaVivoValida(cid, cursoId, vivoId, respuestaId, d) {
      let s = get(/databases/$(database)/documents/colegios/$(cid)/cursos/$(cursoId)/vivo/$(vivoId)).data;
      return d.keys().hasOnly(['uid', 'n', 'r', 'sesion', 'creadoAt'])
        && d.uid == request.auth.uid
        && d.n is int && d.r is int && d.r >= 0
        && s.estado == 'pregunta'
        && s.pregunta.n == d.n
        && d.r < s.pregunta.opciones.size()
        && d.sesion == s.id
        && respuestaId == string(d.n) + '_' + request.auth.uid
        && d.creadoAt == request.time;
    }
    // Una visita más del día `dia` (el contador solo sube de a uno).
    function visitaValida(dia, visitas) {
      return request.resource.data.keys().hasOnly(['dia', 'visitas', 'ultimaAt'])
        && request.resource.data.dia == dia
        && request.resource.data.visitas == visitas
        && request.resource.data.ultimaAt is number;
    }
    function resumenOrbitaValido(d) {
      return d.keys().hasOnly(['xpTotal', 'racha', 'mejorRacha', 'diasAprendiendo', 'actualizadoAt'])
        && d.xpTotal is int && d.xpTotal >= 0
        && d.racha is int && d.racha >= 0
        && d.mejorRacha is int && d.mejorRacha >= 0
        && d.diasAprendiendo is int && d.diasAprendiendo >= 0
        && d.actualizadoAt is number;
    }
    // Shape of an assignment doc (RQ-PR04 mundo, or RQ-PR14 reto). A reto brief
    // can ONLY carry {tipo, cantidad} — a teacher cannot attach free text or
    // montos. `kind` absent = legacy mundo (zero migration). v1 reto enum is only
    // the two least-revealing types; the rest ship after S7/CP sign-off.
    function asignacionShapeValida(d) {
      return d.keys().hasOnly(['kind', 'worldId', 'reto', 'target', 'fechaInicio', 'deadline', 'createdByUid', 'createdAt'])
        && d.target.keys().hasOnly(['tipo', 'cursoId', 'uid'])
        && d.target.tipo in ['curso', 'estudiante']
        && d.target.cursoId is string
        && (d.target.tipo == 'curso' ? !('uid' in d.target.keys()) : d.target.uid is string)
        && d.fechaInicio is number
        && d.deadline is number
        && d.deadline > d.fechaInicio
        && d.createdByUid is string
        && d.createdAt is number
        && (
          ((!('kind' in d.keys()) || d.kind == 'mundo') && d.worldId is string && !('reto' in d.keys()))
          ||
          (d.kind == 'reto'
            && !('worldId' in d.keys())
            && d.reto.keys().hasOnly(['tipo', 'cantidad'])
            && d.reto.tipo in ['registrar_movimientos', 'crear_meta']
            && d.reto.cantidad is int
            && d.reto.cantidad >= 1
            && d.reto.cantidad <= 100)
        );
    }

    // ---- tenancy tree ----
    match /colegios/{cid} {
      // Any member of the colegio reads its identity (nombre/logo for headers).
      // Structure (create/edit/delete) is Admin SDK only (backend).
      allow read: if sameColegio(cid) || isEstudianteDeColegio(cid);
      allow create, update, delete: if false;

      // Dormant entity (RQ-FN01): readable by the profesor if it ever existed; never written.
      match /sedes/{sedeId} {
        allow read: if sameColegio(cid) && isStaff();
        allow write: if false;
      }

      match /cursos/{cursoId} {
        allow get: if isProfesorDe(cid, cursoId)
          || isMiembroDeCurso(cid, cursoId);
        // "Mis clases" del profe: consulta `profesorUids array-contains uid`.
        // isProfesorDe() hace get() con el id del documento y eso no se puede
        // evaluar en un list; aquí la condición se prueba con la propia consulta.
        allow list: if isRole('profesor')
          && sameColegio(cid)
          && request.auth.uid in resource.data.profesorUids;
        // Course structure/settings and the join code are Admin SDK / Function
        // only (backend). No client writes.
        allow create, update, delete: if false;

        // Class configuration (D-ORQ, RQ-PR10): single doc `mundos` — active
        // worlds + order. Read by the course only (its teacher and its students,
        // who subscribe live); written/reset ONLY by the course's teacher.
        // ABSENCE of the doc = defaults, so `delete` is the "restaurar
        // configuración" action. List entries are shape-checked in the client
        // (Zod); here we pin the field set, types and bounds.
        match /config/{configId} {
          allow read: if isProfesorDe(cid, cursoId)
            || isEstudianteActivoEnCurso(cid, cursoId, request.auth.uid);
          allow create, update: if configId == 'mundos'
            && isProfesorDe(cid, cursoId)
            && tienePlanEdicion(cid)
            && request.resource.data.keys().hasOnly(['mundos', 'overrides', 'version', 'updatedAt', 'updatedByUid'])
            && (!('overrides' in request.resource.data) || request.resource.data.overrides is map)
            && request.resource.data.mundos is list
            && request.resource.data.mundos.size() >= 1
            && request.resource.data.mundos.size() <= 30
            && request.resource.data.version is number
            && request.resource.data.updatedAt is number
            && request.resource.data.updatedByUid == request.auth.uid;
          // Fase 5 — `comunicacion`: alertas al profe (on/off y N días) y el
          // resumen para acudientes. El servidor revisa el plan al usarla.
          allow create, update: if configId == 'comunicacion'
            && isProfesorDe(cid, cursoId)
            && request.resource.data.keys().hasOnly(['alertas', 'acudientes', 'actualizadoAt', 'actualizadoPor'])
            && (!('alertas' in request.resource.data) || request.resource.data.alertas is map)
            && (!('acudientes' in request.resource.data) || request.resource.data.acudientes is map)
            && request.resource.data.actualizadoAt is number
            && request.resource.data.actualizadoPor == request.auth.uid;
          // Fase 8 — `grupos` (hasta 12; un estudiante en uno) y `accesibilidad`
          // (leer en voz alta para toda la clase). Cualquier profe de la clase,
          // en todos los planes.
          allow create, update: if configId == 'grupos'
            && isProfesorDe(cid, cursoId)
            && request.resource.data.keys().hasOnly(['grupos', 'actualizadoAt', 'actualizadoPor'])
            && request.resource.data.grupos is list
            && request.resource.data.grupos.size() <= 12
            && request.resource.data.actualizadoAt is number
            && request.resource.data.actualizadoPor == request.auth.uid;
          allow create, update: if configId == 'accesibilidad'
            && isProfesorDe(cid, cursoId)
            && request.resource.data.keys().hasOnly(['leerEnVozAlta', 'actualizadoAt', 'actualizadoPor'])
            && request.resource.data.leerEnVozAlta is bool
            && request.resource.data.actualizadoAt is number
            && request.resource.data.actualizadoPor == request.auth.uid;
          // `prueba` (Fase 7) solo la escribe el callable gestionarPrueba.
          allow delete: if isProfesorDe(cid, cursoId) && configId in ['mundos', 'comunicacion', 'grupos', 'accesibilidad'];
        }

        // Course-custom content (D-ORQ, RQ-PR11/PR12): copy-on-write copies of
        // the default banks + custom-world content. The GLOBAL defaults stay
        // read-only (R8); these copies are written ONLY by the course's teacher
        // and read by the course. Deep item validation lives in the client
        // (Zod); here we gate ownership, doc-id shape and list-size caps.
        // `delete` is "restaurar default" for the piece.
        match /contenido/{docId} {
          allow read: if isProfesorDe(cid, cursoId)
            || isEstudianteActivoEnCurso(cid, cursoId, request.auth.uid);
          allow create, update: if isProfesorDe(cid, cursoId)
            && tienePlanEdicion(cid)
            && (
              (docId.matches('banco_.*')
                && request.resource.data.keys().hasOnly(['bancoId', 'grado', 'worldId', 'tipo', 'version', 'generadoPor', 'pendiente_validacion_docente', 'items'])
                && request.resource.data.items is list
                && request.resource.data.items.size() >= 1
                && request.resource.data.items.size() <= 100)
              || (docId.matches('microteoria_.*')
                && request.resource.data.keys().hasOnly(['grado', 'worldId', 'cards', 'generadoPor', 'pendiente_validacion_docente'])
                && request.resource.data.cards is list
                && request.resource.data.cards.size() >= 1
                && request.resource.data.cards.size() <= 20)
              || (docId.matches('mapa_.*')
                && request.resource.data.keys().hasOnly(['worldId', 'lecciones', 'jefe', 'actualizadoAt'])
                && request.resource.data.lecciones is list
                && request.resource.data.lecciones.size() >= 1
                && request.resource.data.lecciones.size() <= 8
                && request.resource.data.jefe is list
                && request.resource.data.jefe.size() <= 15)
              || (docId.matches('eligeCamino_.*')
                && request.resource.data.keys().hasOnly(['bancoId', 'grado', 'worldId', 'situaciones', 'generadoPor', 'pendiente_validacion_docente'])
                && request.resource.data.situaciones is list
                && request.resource.data.situaciones.size() >= 1
                && request.resource.data.situaciones.size() <= 30)
            );
          allow delete: if isProfesorDe(cid, cursoId);
        }

        match /estudiantes/{uid} {
          // Roster nominal (email+nombre): the course teacher and the student
          // themself only (matriz §1.3).
          allow read: if isProfesorDe(cid, cursoId)
            || (isMiembroDeCurso(cid, cursoId) && request.auth.uid == uid);
          // Roster is mutated ONLY by Cloud Functions (joinByCode / atestar /
          // retirarEstudiante / salirDeMiClase / suppressStudentData) via the Admin SDK — never by a client (D-B1-03).
          allow write: if false;

          match /progress/{worldId} {
            allow read: if isProfesorDe(cid, cursoId)
              || isEstudianteActivoEnCurso(cid, cursoId, uid);
            // Only the student writes their OWN progress, only into a roster slot
            // a Function already created, only while active, and only under their
            // own course claim. Denormalized keys must match the path; values are
            // type/range/size-checked (progress feeds the teacher report).
            allow create, update: if isEstudianteActivoEnCurso(cid, cursoId, uid)
              && request.resource.data.colegioId == cid
              && request.resource.data.cursoId == cursoId
              && request.resource.data.uid == uid
              && request.resource.data.competencia is string
              && request.resource.data.mastery is number
              && request.resource.data.mastery >= 0
              && request.resource.data.mastery <= 1
              && request.resource.data.completed is bool
              && request.resource.data.updatedAt is number;
            allow delete: if false;
          }

          // Prueba de entrada y salida (Fase 7). El estudiante activo guarda su
          // resultado UNA vez y solo mientras su profe tiene esa fase abierta
          // (config/prueba, que escribe el callable gestionarPrueba); el profe
          // de la clase lo lee. No se rehace ni se borra desde el cliente.
          match /impactTest/{fase} {
            allow read: if isProfesorDe(cid, cursoId)
              || isEstudianteActivoEnCurso(cid, cursoId, uid);
            allow create: if isEstudianteActivoEnCurso(cid, cursoId, uid)
              && (fase == 'pre' || fase == 'post')
              && pruebaAbierta(cid, cursoId, fase)
              && request.resource.data.keys().hasOnly(['score', 'total', 'takenAt', 'breakdown', 'totales'])
              && request.resource.data.score is int && request.resource.data.score >= 0
              && request.resource.data.total is int && request.resource.data.total > 0
              && request.resource.data.total <= 60
              && request.resource.data.score <= request.resource.data.total
              && request.resource.data.takenAt is number
              && request.resource.data.breakdown is map
              && request.resource.data.totales is map;
            allow update, delete: if false;
          }

          // Fase 1 — registro de clase (src/features/dashboard/data/registroClase.ts).
          // Solo lo escribe el estudiante activo en ESTA clase (su app solo lo hace
          // desde el espacio de la clase), así el profe ve lo que pasó desde que se
          // unió. Nada se edita ni se borra desde el cliente; el resumen de la
          // clase lo calcula una Function.
          match /intentos/{intentoId} {
            allow read: if isProfesorDe(cid, cursoId)
              || isEstudianteActivoEnCurso(cid, cursoId, uid);
            allow create: if isEstudianteActivoEnCurso(cid, cursoId, uid)
              && intentoValido(request.resource.data, uid);
            allow update, delete: if false;
          }
          match /visitas/{dia} {
            allow read: if isProfesorDe(cid, cursoId)
              || isEstudianteActivoEnCurso(cid, cursoId, uid);
            allow create: if isEstudianteActivoEnCurso(cid, cursoId, uid)
              && visitaValida(dia, 1);
            allow update: if isEstudianteActivoEnCurso(cid, cursoId, uid)
              && visitaValida(dia, resource.data.visitas + 1);
            allow delete: if false;
          }
          match /resumen/{resumenId} {
            allow read: if isProfesorDe(cid, cursoId)
              || isEstudianteActivoEnCurso(cid, cursoId, uid);
            // `orbita` lo escribe el estudiante; `clase`, solo la Function.
            allow create, update: if resumenId == 'orbita'
              && isEstudianteActivoEnCurso(cid, cursoId, uid)
              && resumenOrbitaValido(request.resource.data);
            allow delete: if false;
          }

          // Fase 5 — buzón: mensajes y comentarios del profe para este estudiante.
          // Los escribe solo el callable enviarComunicado. El estudiante activo
          // los lee y solo puede marcarlos como vistos (una vez); no responde.
          match /buzon/{mensajeId} {
            allow read: if isProfesorDe(cid, cursoId)
              || isEstudianteActivoEnCurso(cid, cursoId, uid);
            allow update: if isEstudianteActivoEnCurso(cid, cursoId, uid)
              && resource.data.leidoAt == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leidoAt'])
              && request.resource.data.leidoAt is number;
            allow create, delete: if false;
          }

          // Fase 8 — adaptaciones del estudiante (más tiempo, menos opciones, voz,
          // letra grande). Las pone cualquier profe de la clase; las lee el
          // estudiante activo. No tocan su nota ni los informes.
          match /adaptaciones/{docId} {
            allow read: if isProfesorDe(cid, cursoId)
              || isEstudianteActivoEnCurso(cid, cursoId, uid);
            allow create, update: if docId == 'actual'
              && isProfesorDe(cid, cursoId)
              && request.resource.data.keys().hasOnly(['masTiempo', 'menosOpciones', 'leerEnVozAlta', 'letraGrande', 'actualizadoAt', 'actualizadoPor'])
              && request.resource.data.masTiempo is bool
              && request.resource.data.menosOpciones is bool
              && request.resource.data.leerEnVozAlta is bool
              && request.resource.data.letraGrande is bool
              && request.resource.data.actualizadoAt is number
              && request.resource.data.actualizadoPor == request.auth.uid;
            allow delete: if isProfesorDe(cid, cursoId);
          }

          // Fase 5 — enlace y correo del acudiente (callable gestionarAcudiente).
          // Lo ve solo el profe de la clase: ni el estudiante ni nadie más. El
          // token se resuelve en el servidor (`enlacesAcudiente`, sin acceso).
          match /acudiente/{docId} {
            allow read: if isProfesorDe(cid, cursoId);
            allow write: if false;
          }

        }

        // Fase 8a — clase en vivo (callable operarClaseVivo). La sesión la leen el
        // profe y los estudiantes activos; la clave de respuestas y el registro
        // (`privado`) son solo del servidor. El estudiante marca que entró y
        // responde UNA vez la pregunta abierta; el servidor mide el tiempo
        // con `creadoAt` y puntúa al revelar.
        match /vivo/{vivoId} {
          allow read: if isProfesorDe(cid, cursoId)
            || isEstudianteActivoEnCurso(cid, cursoId, request.auth.uid);
          allow write: if false;

          match /privado/{docId} {
            allow read, write: if false;
          }
          match /presentes/{uid} {
            allow read: if isProfesorDe(cid, cursoId);
            allow create, update: if isEstudianteActivoEnCurso(cid, cursoId, uid)
              && request.resource.data.keys().hasOnly(['sesion', 'entradaAt'])
              && request.resource.data.sesion == get(/databases/$(database)/documents/colegios/$(cid)/cursos/$(cursoId)/vivo/$(vivoId)).data.id
              && request.resource.data.entradaAt is number;
            allow delete: if false;
          }
          match /respuestas/{respuestaId} {
            allow read: if isProfesorDe(cid, cursoId);
            allow create: if isEstudianteActivoEnCurso(cid, cursoId, request.auth.uid)
              && respuestaVivoValida(cid, cursoId, vivoId, respuestaId, request.resource.data);
            allow update, delete: if false;
          }
        }
        // Historial de clases en vivo: cifras de grupo, sin nombres (servidor).
        match /sesionesVivo/{sesionId} {
          allow read: if isProfesorDe(cid, cursoId);
          allow write: if false;
        }

        // Fase 5 — lo que el profe le mandó a la clase (callable enviarComunicado).
        // Los estudiantes activos leen solo los anuncios; los mensajes con
        // destinatarios (`para`, `nombres`) son del profe. El profe puede borrar
        // un anuncio; nada más se escribe desde el cliente.
        match /comunicados/{comunicadoId} {
          allow read: if isProfesorDe(cid, cursoId)
            || (isEstudianteActivoEnCurso(cid, cursoId, request.auth.uid)
              && resource.data.tipo == 'anuncio');
          allow delete: if isProfesorDe(cid, cursoId) && resource.data.tipo == 'anuncio';
          allow create, update: if false;

          // "Visto" de un anuncio: el estudiante deja una marca suya, una vez.
          match /vistos/{uid} {
            allow read: if isProfesorDe(cid, cursoId)
              || isEstudianteActivoEnCurso(cid, cursoId, uid);
            allow create: if isEstudianteActivoEnCurso(cid, cursoId, uid)
              && get(/databases/$(database)/documents/colegios/$(cid)/cursos/$(cursoId)/comunicados/$(comunicadoId)).data.tipo == 'anuncio'
              && request.resource.data.keys().hasOnly(['vistoAt'])
              && request.resource.data.vistoAt is number;
            allow update, delete: if false;
          }
        }

        // Per-course aggregates (RQ-FN09): NO individual minor data. Readable by
        // any profesor of the colegio (institutional reporting moved to profesor,
        // D-PIVOT); written ONLY by a Function (Admin SDK).
        match /agregados/{agregadoId} {
          allow read: if sameColegio(cid) && isStaff();
          allow write: if false;
        }

      }

      match /asignaciones/{aid} {
        allow read: if isProfesorDe(cid, resource.data.target.cursoId)
          || (isEstudianteActivoEnCurso(cid, resource.data.target.cursoId, request.auth.uid)
            && (resource.data.target.tipo == 'curso'
              || (resource.data.target.tipo == 'estudiante'
                && resource.data.target.uid == request.auth.uid)));
        // Create/operate: the target course's teacher (matriz §1.3). Shape is now
        // validated so a reto brief cannot smuggle free text or montos (RQ-PR14).
        allow create: if isProfesorDe(cid, request.resource.data.target.cursoId)
          && request.resource.data.createdByUid == request.auth.uid
          && asignacionShapeValida(request.resource.data);
        allow update: if isProfesorDe(cid, resource.data.target.cursoId)
          && request.resource.data.target == resource.data.target
          && request.resource.data.createdByUid == resource.data.createdByUid
          && asignacionShapeValida(request.resource.data);
        allow delete: if isProfesorDe(cid, resource.data.target.cursoId);
      }
    }

    // No collection-group progress reads (D-PIVOT). The profesor reads their
    // course's progress via the nested per-course rule (direct doc reads,
    // authorized by isProfesorDe on the path) and reads colegio-wide compliance
    // from the non-nominal agregados/*. A colegio-wide collection-group query
    // can't satisfy isProfesorDe anyway (cursoId is unconstrained in a `list`),
    // so there is deliberately no such rule — those queries default-deny.

    // uid → tenant mapping, set by the Function; the user reads only their own.
    match /membership/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- account-scoped (auth user) ----
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function validMoney(value) {
      return value is int && value > 0 && value <= 100000000;
    }
    function validTimestamp(value) {
      return value is number && value >= 0;
    }
    function validGoal(d, goalId) {
      return d.keys().hasOnly(['id', 'title', 'iconId', 'category', 'targetAmount', 'deadline', 'createdAt', 'updatedAt', 'deletedAt'])
        && d.keys().hasAll(['id', 'title', 'iconId', 'category', 'targetAmount', 'createdAt', 'updatedAt'])
        && d.id == goalId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.iconId in ['bike', 'book', 'laptop', 'plane', 'shield', 'target']
        && d.category in ['electronics', 'toy', 'trip', 'education', 'emergency', 'custom']
        && validMoney(d.targetAmount)
        && validTimestamp(d.createdAt) && validTimestamp(d.updatedAt)
        && (!('deadline' in d) || validTimestamp(d.deadline))
        && (!('deletedAt' in d) || validTimestamp(d.deletedAt));
    }
    function validSavingsOperation(d, operationId) {
      return d.keys().hasOnly(['id', 'type', 'amount', 'description', 'goalId', 'fecha', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'type', 'amount', 'description', 'fecha', 'createdAt', 'updatedAt'])
        && d.id == operationId
        && d.type in ['aporte', 'retiro']
        && validMoney(d.amount)
        && d.description is string && d.description.size() <= 140
        && (!('goalId' in d) || (d.goalId is string && d.goalId.size() > 0))
        && validTimestamp(d.fecha) && validTimestamp(d.createdAt) && validTimestamp(d.updatedAt);
    }
    function validBudgetAmount(topes, key) {
      return !(key in topes) || validMoney(topes[key]);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && request.resource.data.displayName is string
        && request.resource.data.provider is string;
      allow update: if isSelf(userId);
      allow delete: if false;

      // ── ORBITA (inicio) ──
      // Estado de juego (racha, XP, meta, Cetis virtuales, Bóveda). Un solo doc
      // `orbita`, self-only: ni profe ni admin lo leen (los agregados de flota,
      // si existen, van aparte). No es un perfil financiero: nunca lleva montos
      // reales. Se valida la forma y el tamaño; los números de juego son del
      // cliente (Cetis no valen plata, no hay nada que robar).
      match /juego/{docId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && docId == 'orbita'
          && request.resource.data.keys().hasOnly(['version', 'racha', 'progreso', 'boveda', 'niveles', 'ajustes', 'actualizadoEn'])
          && request.resource.data.keys().hasAll(['version', 'racha', 'progreso', 'boveda', 'niveles', 'ajustes', 'actualizadoEn'])
          && request.resource.data.version == 1
          && request.resource.data.racha is map
          && request.resource.data.racha.dias is list && request.resource.data.racha.dias.size() <= 400
          && request.resource.data.racha.cubiertos is list && request.resource.data.racha.cubiertos.size() <= 400
          && request.resource.data.racha.escudos is int
          && request.resource.data.racha.escudos >= 0 && request.resource.data.racha.escudos <= 2
          && request.resource.data.progreso is map
          && request.resource.data.boveda is map
          && request.resource.data.boveda.cdts is list && request.resource.data.boveda.cdts.size() <= 3
          && request.resource.data.niveles is map
          && request.resource.data.ajustes is map
          && request.resource.data.ajustes.meta in ['crucero', 'orbita', 'hiper']
          && request.resource.data.actualizadoEn is int;
        allow delete: if false;
      }
      // ── ORBITA (fin) ──

      // Simulated savings (virtual money).
      match /goals/{goalId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) && validGoal(request.resource.data, goalId);
        allow update: if isSelf(userId)
          && validGoal(request.resource.data, goalId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /deposits/{depositId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) && validSavingsOperation(request.resource.data, depositId);
        allow update: if isSelf(userId)
          && validSavingsOperation(request.resource.data, depositId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isSelf(userId);
      }

      // Pocket-money diary (RQ-ES10). Self-only by design: NO staff role — not
      // even admin — may read a student's individual movimientos (CA5). Hard
      // validation mirrors the function's classifier (enums + monto 0..1e8) and
      // pins the field set with hasOnly, since the client writes this doc
      // directly (setDoc) — the rules are the only server-side gate.
      match /movimientos/{movimientoId} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['id', 'tipo', 'monto', 'descripcion', 'categoria', 'origen', 'fecha', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['id', 'tipo', 'monto', 'descripcion', 'categoria', 'origen', 'fecha', 'createdAt', 'updatedAt'])
          && request.resource.data.id == movimientoId
          && request.resource.data.tipo == 'gasto'
          && validMoney(request.resource.data.monto)
          && request.resource.data.descripcion is string
          && request.resource.data.descripcion.size() <= 140
          && request.resource.data.categoria in ['comida', 'transporte', 'entretenimiento', 'ropa', 'educacion', 'tecnologia', 'regalos', 'otros']
          && request.resource.data.origen in ['voz', 'manual']
          && validTimestamp(request.resource.data.fecha)
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt)
          && (request.method == 'create' || (
            request.resource.data.id == resource.data.id
            && request.resource.data.tipo == resource.data.tipo
            && request.resource.data.createdAt == resource.data.createdAt
          ));
      }

      // Budgets config (RQ-ES11-CA1). Self-only, self-view: NO staff/admin read,
      // like movimientos (CA5). Written whole (no merge) so removing a tope drops
      // the key. hasOnly pins the shape and the category keys; the client writes
      // this doc directly (setDoc) — the rules are the only server-side gate.
      match /config/{docId} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && docId == 'presupuestos'
          && request.resource.data.keys().hasOnly(['topes', 'updatedAt'])
          && request.resource.data.updatedAt is number
          && request.resource.data.topes is map
          && request.resource.data.topes.keys().hasOnly(['comida', 'transporte', 'entretenimiento', 'ropa', 'educacion', 'tecnologia', 'regalos', 'otros'])
          && validBudgetAmount(request.resource.data.topes, 'comida')
          && validBudgetAmount(request.resource.data.topes, 'transporte')
          && validBudgetAmount(request.resource.data.topes, 'entretenimiento')
          && validBudgetAmount(request.resource.data.topes, 'ropa')
          && validBudgetAmount(request.resource.data.topes, 'educacion')
          && validBudgetAmount(request.resource.data.topes, 'tecnologia')
          && validBudgetAmount(request.resource.data.topes, 'regalos')
          && validBudgetAmount(request.resource.data.topes, 'otros');
      }
    }

    // Global, shared content banks (grado×mundo×tipo). Doc id is
    // `${grado}_${worldId}_${tipo}` (R8). This is shared global CONTENT, not
    // tenant data, so any signed-in user may read it. Seeded ONLY by the Admin
    // SDK from content/approved/ (R8 / CN05) — never client-writable.
    match /bancos/{bancoId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // EligeCamino situational banks (grado×mundo). Doc id is `${grado}_${worldId}`
    // (R8). Shared global CONTENT — any signed-in user may read it. Seeded ONLY by
    // the Admin SDK from content/bancos/ (R8 / CN05) — never client-writable.
    match /bancosEligeCamino/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Micro-teoría cards (grado×mundo). Doc id is `${grado}_${worldId}` (R8).
    // Shared global CONTENT — any signed-in user may read it. Seeded ONLY by the
    // Admin SDK from content/microteoria/ (R8 / CN05) — never client-writable.
    match /microteoria/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Class join codes: resolved only by the joinByCode Function (Admin SDK).
    // Never exposed to clients (codes must not be enumerable).
    match /classCodes/{code} {
      allow read, write: if false;
    }

    // ── EDUCADORES (inicio) ──
    // Cobros y retención del profe (docs/educadores/modelo-datos.md). Todo lo
    // escriben Cloud Functions (Admin SDK); el cliente solo lee lo suyo.
    match /suscripciones/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;

      // Contador mensual de IA: lo escribe el servidor al generar.
      match /uso/{mes} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Pagos, cobros recurrentes y reembolsos. Se lista con where('uid', '==', …).
    match /pagos/{pagoId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Bitácora del domingo (la genera bitacoraSemanal).
    match /bitacoras/{uid}/semanas/{semana} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Solo servidor: facturas, idempotencia del webhook, contador de fundadores y
    // la cola de la extensión Trigger Email.
    match /facturas/{id} {
      allow read, write: if false;
    }
    match /eventosPago/{id} {
      allow read, write: if false;
    }
    match /fundadores/{id} {
      allow read, write: if false;
    }
    match /mail/{id} {
      allow read, write: if false;
    }

    // Lista del curso invitada por correo (invitarLista). La lee un profe de la
    // clase; solo la escribe el servidor. El doc de búsqueda por correo es solo
    // del servidor (resolveMyAccess).
    match /colegios/{cid}/cursos/{cursoId}/invitados/{correo} {
      allow read: if isProfesorDe(cid, cursoId);
      allow write: if false;
    }
    match /invitacionesPorCorreo/{correo} {
      allow read, write: if false;
    }

    // Adopción del colegio (adopcionColegio.ts): solo cifras, ningún dato
    // nominal. La lee cualquier profe del colegio; solo la escribe el servidor.
    match /colegios/{cid}/agregados/adopcion {
      allow read: if isStaff() && sameColegio(cid);
      allow write: if false;
    }

    // ---- Fase 6 — entidades (functions/src/educadores/entidades.ts) ----
    // El admin de la entidad es un permiso de un profesor guardado en su ficha
    // de miembro (no un claim ni un rol): se revisa en cada lectura, así quien
    // sale de la entidad pierde el acceso al instante. Todo lo escribe el
    // servidor; el cliente solo lee.
    function esAdminEntidad(cid) {
      return isStaff() && sameColegio(cid)
        && get(/databases/$(database)/documents/colegios/$(cid)/profes/$(request.auth.uid)).data.rol == 'admin';
    }
    // Miembros de la entidad: los ven sus profes (para co-docentes y la biblioteca).
    match /colegios/{cid}/profes/{uid} {
      allow read: if isStaff() && sameColegio(cid);
      allow write: if false;
    }
    match /colegios/{cid}/invitacionesProfe/{correo} {
      allow read: if esAdminEntidad(cid);
      allow write: if false;
    }
    // Escala SIEE y periodos: la aplican todas las clases de la entidad.
    match /colegios/{cid}/config/{docId} {
      allow read: if isStaff() && sameColegio(cid);
      allow write: if false;
    }
    match /colegios/{cid}/biblioteca/{id} {
      allow read: if isStaff() && sameColegio(cid);
      allow write: if false;
    }
    // Panel (solo cifras de grupo), datos de factura y cotizaciones: solo admins.
    match /colegios/{cid}/agregados/entidad {
      allow read: if esAdminEntidad(cid);
      allow write: if false;
    }
    match /colegios/{cid}/facturacion/{docId} {
      allow read: if esAdminEntidad(cid);
      allow write: if false;
    }
    match /colegios/{cid}/cotizaciones/{id} {
      allow read: if esAdminEntidad(cid);
      allow write: if false;
    }
    // Fase 7 — cierres de periodo: copia fija del informe de cobertura para
    // auditorías. La escribe una vez el callable cerrarPeriodoEntidad.
    match /colegios/{cid}/cierres/{id} {
      allow read: if esAdminEntidad(cid);
      allow write: if false;
    }
    match /invitacionesProfe/{id} {
      allow read, write: if false;
    }
    match /contadores/{id} {
      allow read, write: if false;
    }

    // ¿El profe puede editar contenido y la configuración de mundos? Piloto o
    // superior vigente (suscripciones/{uid}.planVigente + vigenteHasta, que
    // escribe el servidor), o la licencia Nave vigente del colegio. Al bajar de
    // plan no se borra nada: solo deja de poder escribir (restaurar sigue libre).
    function tienePlanEdicion(cid) {
      let subRef = /databases/$(database)/documents/suscripciones/$(request.auth.uid);
      let licencia = get(/databases/$(database)/documents/colegios/$(cid)).data.get('licencia', {});
      return (exists(subRef)
          && get(subRef).data.get('planVigente', '') in ['piloto', 'comandante', 'nave']
          && request.time.toMillis() < get(subRef).data.get('vigenteHasta', 0))
        // Fase 6: la Nave de antes o un plan de entidad (Equipo, Colegio, Universidad).
        || (licencia.get('plan', '') in ['nave', 'equipo', 'colegio', 'universidad']
          && request.time.toMillis() < licencia.get('hasta', 0));
    }
    // Fase 5 — avisos de la app (functions/src/educadores/notificaciones.ts).
    // El doc raíz guarda los tokens de push del celular del usuario; los avisos
    // los escribe solo el servidor y el usuario solo los marca como leídos o los
    // borra.
    match /notificaciones/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['expoTokens', 'actualizadoAt'])
        && request.resource.data.expoTokens is list
        && request.resource.data.expoTokens.size() <= 5
        && request.resource.data.actualizadoAt is number;

      match /items/{itemId} {
        allow read, delete: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leidaAt'])
          && request.resource.data.leidaAt is number;
        allow create: if false;
      }
    }
    // Mi banco de preguntas (Fase 4): preguntas que el profe reutiliza entre
    // clases y mundos. Solo su dueño, y solo con forma válida.
    match /bancosProfe/{uid}/preguntas/{preguntaId} {
      allow read, delete: if isSelf(uid) && isStaff();
      allow create, update: if isSelf(uid) && isStaff()
        && request.resource.data.keys().hasOnly(['item', 'tipo', 'temas', 'origen', 'creadoAt'])
        && request.resource.data.item is map
        && request.resource.data.tipo in ['multiple_choice', 'true_false', 'ordenar', 'emparejar', 'completar', 'numerica']
        && request.resource.data.temas is list
        && request.resource.data.temas.size() <= 10
        && request.resource.data.creadoAt is number;
    }
    // ── EDUCADORES (fin) ──

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
