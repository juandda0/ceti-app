# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Firebase service account (nunca commitear — tiene privilegios de admin)
serviceAccount.json
serviceAccount*.json
dist-scripts/

# Cloud Functions (salida de tsc)
functions/lib/

# Firebase emulator debug logs
*-debug.log
firestore-debug.log
firebase-debug.log
ui-debug.log

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Harness — artefactos generados (no versionar)
.firebase/
content/approved/*.json
.pr-msg.txt

# Claude Code — settings personales (no compartir; settings.json sí se versiona)
.claude/settings.local.json

# Secrets locales del emulador de functions (RQ-ES10)
functions/.secret.local

# Artefactos locales del acompañamiento visual
.superpowers/
.playwright-cli/

# Configuración del IDE y capturas temporales
.idea/
.tmp-figma-shots/
