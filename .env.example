# Ceti — plantilla (sin secretos). Copia a `.env` y rellena con tus valores reales.

# Backend Spring Boot (ver backend/ y docker-compose.yml). Sin esto la app corre en modo solo local.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google Sign-In: OAuth 2.0 client tipo "Web" de Google Cloud (NO el de Android).
# El mismo ID (y los de iOS/Android) va en CETI_GOOGLE_CLIENT_IDS del backend.
# Si ves DEVELOPER_ERROR en Android: registra el SHA-1 del keystore en el OAuth client Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS (opcional): solo si compilas para iOS
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Solo desarrollo/E2E: muestra "Entrar (modo desarrollo)" en el login.
# Requiere CETI_DEV_LOGIN=true en el backend. NUNCA en producción.
EXPO_PUBLIC_DEV_LOGIN=0

# Ley 1581: URL pública de la política de tratamiento de datos (se enlaza in-app)
EXPO_PUBLIC_PRIVACY_POLICY_URL=

EXPO_PUBLIC_APP_ENV=development

# Opcional: EAS / iOS
# EAS_PROJECT_ID=
# IOS_BUNDLE_ID=com.juanndda.ceti
