#!/usr/bin/env sh
# E11 — gate local barato. invariant-lint (E4) + lint-staged (prettier) +
# typecheck + (test:rules si el commit toca firestore.rules/paths.ts, E7).
# El resto del suite pesado (test, audit, functions) queda para CI (E10).

node scripts/invariantLint.mjs || exit 1
npx lint-staged || exit 1
npm run typecheck || exit 1

if git diff --cached --name-only | grep -Eq 'firestore\.rules|paths\.ts'; then
  echo "[pre-commit] firestore.rules/paths.ts en el commit → test:rules (E7)"
  npm run test:rules || exit 1
fi
